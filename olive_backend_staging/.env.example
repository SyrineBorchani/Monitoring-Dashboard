TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
POWERBI_BASE_URL=https://api.powerbi.com/v1.0/myorg
FABRIC_BASE_URL=https://api.fabric.microsoft.com/v1
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/monitoring_dashboard
FABRIC_SQL_MONITORING_ENABLED=false
FABRIC_SQL_SOURCE=auto
FABRIC_SQL_NOTEBOOK_EXPORT_PATH=
FABRIC_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
FABRIC_SQL_CONNECT_TIMEOUT=15
FABRIC_SQL_COMMAND_TIMEOUT=30
FABRIC_SQL_TOP=50
