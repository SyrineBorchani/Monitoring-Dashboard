{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "framework": null,
  "outputDirectory": "App/static",
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://monitoring-dashboard-8p9w.onrender.com/api/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/"
    }
  ]
}
